[Desktop Entry]
Type=Application
Name=PotLinux
Comment=PotPlayer-style media player
Exec=PYBIN POTLINUX_PY %F
Icon=multimedia-video-player
Terminal=false
Categories=AudioVideo;Player;Video;Audio;
